---
// One file for both languages: Workers serves this for any missing path, and
// the copy follows the URL (/zh/... gets Chinese), like the rest of the site.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { path, t } from "../i18n/ui";

const en = t("en").notFound;
const zh = t("zh").notFound;
---

<Base title={en.title} description={en.description} lang="en" alternates={{ en: `${import.meta.env.BASE_URL}404`, zh: `${import.meta.env.BASE_URL}404` }}>
  <Header lang="en" otherHref={path("zh", "/")} />
  <main class="not-found">
    <div class="shell">
      <img
        class="lost"
        src={`${import.meta.env.BASE_URL}mascot/anka-lost.webp`}
        alt=""
        width="520"
        height="550"
        decoding="async"
      />
      <h1>404</h1>
      <p data-copy="en">{en.body}</p>
      <p data-copy="zh" lang="zh-CN" hidden>{zh.body}</p>
      <a class="btn btn-primary" href={import.meta.env.BASE_URL} data-home>{en.home}</a>
    </div>
  </main>
  <Footer lang="en" />
</Base>

<script>
  // The site is served from "/" on Cloudflare and "/<repo>/" on GitHub Pages.
  const base = document.querySelector<HTMLAnchorElement>("[data-home]")?.getAttribute("href") ?? "/";
  const here = location.pathname.slice(base.length);
  if (here === "zh" || here.startsWith("zh/")) {
    document.documentElement.lang = "zh-CN";
    document.body.dataset.lang = "zh";
    for (const el of document.querySelectorAll<HTMLElement>("[data-copy]")) {
      el.hidden = el.dataset.copy !== "zh";
    }
    const home = document.querySelector<HTMLAnchorElement>("[data-home]");
    if (home) {
      home.href = `${base}zh/`;
      home.textContent = "返回首页";
    }
    const switcher = document.getElementById("lang-switch");
    if (switcher) switcher.setAttribute("href", base);
  }
</script>

<style>
  .not-found { min-height: 62vh; display: flex; align-items: center; text-align: center; padding: 64px 0; }
  .lost { display: block; width: 200px; height: auto; margin: 0 auto; }
  h1 { margin-top: 12px; font-size: 72px; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  p { margin: 10px 0 28px; color: var(--text-2); }
</style>
