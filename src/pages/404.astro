---
// One file for both languages: Workers serves this for any missing path, and
// the copy follows the URL (/zh/... gets Chinese), like the rest of the site.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import BrandMark from "../components/BrandMark.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n/ui";

const en = t("en").notFound;
const zh = t("zh").notFound;
---

<Base title={en.title} description={en.description} lang="en" alternates={{ en: "/404", zh: "/404" }}>
  <Header lang="en" otherHref="/zh/" />
  <main class="not-found">
    <div class="shell">
      <BrandMark size={40} />
      <h1>404</h1>
      <p data-copy="en">{en.body}</p>
      <p data-copy="zh" lang="zh-CN" hidden>{zh.body}</p>
      <a class="btn btn-primary" href="/" data-home>{en.home}</a>
    </div>
  </main>
  <Footer lang="en" />
</Base>

<script>
  if (location.pathname === "/zh" || location.pathname.startsWith("/zh/")) {
    document.documentElement.lang = "zh-CN";
    document.body.dataset.lang = "zh";
    for (const el of document.querySelectorAll<HTMLElement>("[data-copy]")) {
      el.hidden = el.dataset.copy !== "zh";
    }
    const home = document.querySelector<HTMLAnchorElement>("[data-home]");
    if (home) {
      home.href = "/zh/";
      home.textContent = "回到首页";
    }
    const switcher = document.getElementById("lang-switch");
    if (switcher) switcher.setAttribute("href", "/");
  }
</script>

<style>
  .not-found { min-height: 62vh; display: flex; align-items: center; text-align: center; padding: 64px 0; }
  h1 { margin-top: 20px; font-size: 72px; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  p { margin: 10px 0 28px; color: var(--text-2); }
</style>
