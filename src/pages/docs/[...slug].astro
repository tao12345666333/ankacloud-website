---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import { defaultLang, path, type Lang } from "../../i18n/ui";

export async function getStaticPaths() {
  const en = await getCollection("en");
  return en.map((entry) => ({ params: { slug: entry.id }, props: { entry, lang: defaultLang } }));
}

interface Props {
  entry: CollectionEntry<"en">;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
---

<Doc
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.eyebrow}
  lang={lang}
  otherHref={path("zh", `docs/${entry.id}`)}
  alternates={{ en: path("en", `docs/${entry.id}`), zh: path("zh", `docs/${entry.id}`) }}
>
  <Content />
</Doc>
