---
import BrandMark from "./BrandMark.astro";
import { REPO_URL } from "../data/site";
import { languages, path, t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** This page in the other language. */
  otherHref: string;
}

const { lang, otherHref } = Astro.props;
// The home anchor works under any base path (Cloudflare serves "/", GitHub
// Pages serves "/<repo>/").
const home = import.meta.env.BASE_URL;
const d = t(lang);
const other: Lang = lang === "en" ? "zh" : "en";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={home} aria-label={d.header.home}>
      <BrandMark size={32} />
      <span class="brand-name">anka<span class="brand-name-tail">cloud</span></span>
    </a>

    <nav class="header-nav" aria-label="Main">
      <a href={`${path(lang, "/")}#features`}>{d.header.nav.features}</a>
      <a href={`${path(lang, "/")}#architecture`}>{d.header.nav.architecture}</a>
      <a href={`${path(lang, "/")}#memory`}>{d.header.nav.memory}</a>
      <a href={`${path(lang, "/")}#quickstart`}>{d.header.nav.quickstart}</a>
    </nav>

    <div class="header-actions">
      <a
        class="lang-switch"
        id="lang-switch"
        href={otherHref}
        hreflang={other}
        lang={other}
        title={languages[other]}
      >
        {languages[other]}
      </a>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label={d.header.theme} title={d.header.theme}>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <a class="btn btn-sm btn-outline" href={REPO_URL} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const isDark = () =>
    root.dataset.theme === "dark" ||
    (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);

  const paint = () => button?.setAttribute("aria-pressed", String(isDark()));
  paint();

  button?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("ankacloud.theme", next); } catch {}
    paint();
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s ease;
  }
  .site-header.scrolled { border-bottom-color: var(--border); }
  .header-inner { display: flex; align-items: center; gap: 28px; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .brand-name { font-weight: 680; font-size: 16.5px; letter-spacing: -0.02em; }
  .brand-name-tail { color: var(--text-3); }
  .header-nav { display: flex; align-items: center; gap: 4px; margin-left: 8px; }
  .header-nav a {
    padding: 7px 11px; border-radius: var(--r-sm); color: var(--text-2);
    font-size: 14px; font-weight: 500;
  }
  .header-nav a:hover { background: var(--surface-2); color: var(--text); text-decoration: none; }
  .header-actions { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .lang-switch {
    display: inline-flex; align-items: center; height: 30px; padding: 0 10px;
    border-radius: var(--r-sm); color: var(--text-2); font-size: 13px; font-weight: 500;
    border: 1px solid transparent;
  }
  .lang-switch:hover { background: var(--surface-2); color: var(--text); text-decoration: none; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; padding: 0; border-radius: var(--r-sm);
    border: 1px solid transparent; background: transparent; color: var(--text-2); cursor: pointer;
  }
  .icon-btn:hover { background: var(--surface-2); color: var(--text); }
  .icon-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7;
                  stroke-linecap: round; stroke-linejoin: round; }
  .i-moon { display: none; }
  :root[data-theme="dark"] .i-sun { display: none; }
  :root[data-theme="dark"] .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .i-sun { display: none; }
    :root:not([data-theme="light"]) .i-moon { display: block; }
  }
  @media (max-width: 820px) {
    .header-nav { display: none; }
  }
  @media (max-width: 460px) {
    .header-actions .btn span { display: none; }
    .header-actions .btn { padding: 0 9px; }
    .lang-switch { padding: 0 7px; }
  }
</style>

<script>
  // The border appears only once the page has moved, so the header floats over
  // the hero instead of drawing a line across it.
  const header = document.querySelector(".site-header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });
</script>
