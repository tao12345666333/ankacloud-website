---
// The hero screenshot: a real capture in a browser-chrome frame.
import Screenshot from "./Screenshot.astro";

interface Props {
  name: string;
  width: number;
  height: number;
  crop?: string;
  alt: string;
  caption?: string;
  class?: string;
}

const { name, width, height, crop, alt, caption, class: cls } = Astro.props;
---

<figure class:list={["shot", cls]}>
  <div class="frame">
    <div class="bar" aria-hidden="true">
      <span class="lights"><i /><i /><i /></span>
      <span class="url">
        <svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="9.5" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /></svg>
        ankacloud.example
      </span>
      <span class="bar-spacer" aria-hidden="true"></span>
    </div>
    <div class="body">
      <Screenshot name={name} width={width} height={height} crop={crop} alt={alt} />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot { margin: 0; }
  .frame {
    border-radius: var(--r-lg); overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    box-shadow: var(--shadow-3);
  }
  .body { display: block; }
  .body :global(.frame) { border: none; border-radius: 0; box-shadow: none; }
  .bar {
    display: flex; align-items: center; gap: 12px; height: 34px; padding: 0 12px;
    background: var(--surface-2); border-bottom: 1px solid var(--border);
  }
  .lights { display: inline-flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .url {
    display: inline-flex; align-items: center; gap: 6px; margin: 0 auto;
    height: 22px; padding: 0 12px; border-radius: 6px;
    background: var(--surface); border: 1px solid var(--border);
    font-size: 11.5px; color: var(--text-3); font-family: var(--font-mono);
  }
  .url svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2; }
  .bar-spacer { width: 42px; flex: none; }
  figcaption { margin-top: 12px; font-size: 13px; color: var(--text-3); text-align: center; }
</style>
