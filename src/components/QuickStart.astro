---
import { DOCS, INSTALL, REPO_URL, UV_URL } from "../data/site";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).quickstart;
const tabs = [
  { label: d.local, cmd: INSTALL.run },
  { label: d.server, cmd: INSTALL.install },
];
---

<section class="section" id="quickstart">
  <div class="shell quick">
    <div class="quick-copy">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2>{d.title}</h2>
      <p class="lede">
        {d.ledeBefore}<a href={UV_URL} target="_blank" rel="noopener">uv</a>{d.ledeAfter}<code>E2B_API_KEY</code>{d.ledeAnd}<code>OR_*</code>{d.ledeEnd}
      </p>
      <div class="steps">
        <div class="step">
          <span class="step-no">1</span>
          <div>
            <b>{d.step1}</b>
            <pre class="code"><code><span class="c">$</span> git clone {REPO_URL}.git
<span class="c">$</span> cd ankacloud
<span class="c">$</span> uv sync --frozen</code></pre>
          </div>
        </div>
        <div class="step">
          <span class="step-no">2</span>
          <div>
            <b>{d.step2}</b>
            <p class="keys">
              {INSTALL.env.map((k) => <code>{k}</code>)}
            </p>
          </div>
        </div>
        <div class="step">
          <span class="step-no">3</span>
          <div>
            <b>{d.step3}</b>
            <pre class="code"><code><span class="c">$</span> uv run uvicorn ankacloud.main:app \
    --host 127.0.0.1 --port 8000
<span class="c"># →</span> <span class="p">{`{"ok": true}`}</span>  <span class="c">http://127.0.0.1:8000/api/health</span></code></pre>
          </div>
        </div>
      </div>
      <p class="links">
        <a href={DOCS.quickstart} target="_blank" rel="noopener">{d.links.quick} →</a>
        <a href={DOCS.deploy} target="_blank" rel="noopener">{d.links.deploy} →</a>
      </p>
    </div>

    <div class="quick-terminal" aria-label="ankacloud shell">
      <div class="term-bar"><span class="lights"><i></i><i></i><i></i></span><span style="width:42px;flex:none"></span><span class="term-title">ankacloud — shell</span><span style="width:42px;flex:none"></span></div>
      <div class="term-body">
        {
          tabs.map((tab) => (
            <div class="term-block">
              <span class="term-tab">{tab.label}</span>
              <pre><code><span class="c">$</span> {tab.cmd}</code></pre>
            </div>
          ))
        }
        <div class="term-log">
          <p><span class="c">INFO</span> ankacloud: {d.logs[0][0]} <b>{d.logs[0][1]}</b></p>
          <p><span class="c">INFO</span> ankacloud: {d.logs[1][0]} <b>{d.logs[1][1]}</b> {d.logs[1][2]} <b>{d.logs[1][3]}</b></p>
          <p><span class="c">INFO</span> ankacloud: {d.logs[2][0]} <span class="off">{d.logs[2][1]}</span></p>
          <p><span class="ok">GET</span> /api/health <span class="p">200</span> <span class="c">{`{"ok": true}`}</span></p>
          <p class="cursor-line"><span class="c">$</span> <span class="cursor"></span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  code { font-family: var(--font-mono); font-size: 12.5px; }
  .quick { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 56px; align-items: start; }
  .quick-copy h2 { font-size: clamp(28px, 3.6vw, 40px); margin-top: 14px; }
  .lede { margin-top: 16px; font-size: 15.5px; line-height: 1.75; color: var(--text-2); }
  .lede code, .keys code { background: var(--code-bg); border: 1px solid var(--code-border); border-radius: 5px; padding: 1px 6px; color: var(--text); }

  .steps { display: flex; flex-direction: column; gap: 22px; margin-top: 30px; }
  .step { display: flex; gap: 14px; }
  .step-no {
    flex: none; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border-strong); background: var(--surface); color: var(--text-2);
    font-size: 12px; font-weight: 650; font-variant-numeric: tabular-nums; margin-top: 1px;
  }
  .step b { display: block; font-size: 14.5px; font-weight: 620; }
  .step .code { margin-top: 10px; font-size: 12.5px; padding: 12px 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .keys { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 28px; font-size: 14px; font-weight: 500; }

  .quick-terminal {
    border-radius: var(--r-lg); overflow: hidden; background: #17150f; border: 1px solid #2c2a22;
    box-shadow: var(--shadow-3); position: sticky; top: 88px;
  }
  :root[data-theme="dark"] .quick-terminal { background: #1c1b15; }
  .term-bar { display: flex; align-items: center; height: 34px; padding: 0 12px; background: #1f1d17;
              border-bottom: 1px solid #2c2a22; }
  .lights { display: inline-flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: #3a372d; }
  .term-title { margin: 0 auto; font-family: var(--font-mono); font-size: 11px; color: #918b7c; }
  .term-body { padding: 18px 20px 22px; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.8; color: #d9d3c5; }
  .term-block + .term-block { margin-top: 12px; }
  .term-tab { display: inline-block; margin-bottom: 4px; padding: 0 8px; border-radius: 5px; background: #26241d;
              font-size: 10.5px; color: #918b7c; letter-spacing: .04em; text-transform: uppercase; }
  .term-body pre { margin: 0; white-space: pre-wrap; word-break: break-all; }
  .term-log { margin-top: 18px; padding-top: 14px; border-top: 1px dashed #2c2a22; color: #c9c3b3; }
  .term-log p { margin: 0; font-size: 12px; }
  .term-log b { color: #ece7d9; font-weight: 600; }
  .c { color: #7a7466; }
  .p { color: #e2764c; }
  .ok { color: #9fc2a6; }
  .off { color: #7a7466; }
  .cursor-line { margin-top: 4px !important; }
  .cursor { display: inline-block; width: 7px; height: 14px; vertical-align: -2px; border-radius: 2px;
            background: #e2764c; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 900px) {
    .quick { grid-template-columns: 1fr; gap: 36px; }
    .quick-terminal { position: static; }
  }
</style>
