---
// The rest of the feature list, kept quiet: it is the README's key features,
// one line each, so nothing a reader came looking for is missing. Four of them
// carry a real capture of the setting they describe.
import Screenshot from "./Screenshot.astro";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).capabilities;
---

<section class="section" id="capabilities">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 set:html={d.title} />
    </div>
    <ul class="caps">
      {
        d.items.map((item) => {
          const key = "shot" in item ? item.shot : null;
          const shot = key ? d.shots[key as keyof typeof d.shots] : null;
          return (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {shot && (
                <Screenshot
                  name={`settings-${key}`}
                  width={1280}
                  height={900}
                  crop="top:340"
                  alt={shot.alt}
                  class="cap-shot"
                />
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .caps {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border); border-left: 1px solid var(--border);
    border-radius: var(--r-lg); overflow: hidden; background: var(--surface);
  }
  .caps li {
    display: flex; flex-direction: column; padding: 24px;
    border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
  }
  .cap-shot { margin-top: 18px; }
  .cap-shot :global(figcaption) { display: none; }
  h3 { font-size: 15px; font-weight: 620; letter-spacing: -0.01em; }
  p { margin-top: 8px; font-size: 13.5px; line-height: 1.7; color: var(--text-2); }
  @media (max-width: 900px) {
    .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .caps { grid-template-columns: 1fr; }
    .caps li { padding: 20px; }
  }
</style>
