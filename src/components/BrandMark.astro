---
// The product's sidebar mark: a terracotta tile with the agent's "eye".
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
const radius = Math.round(size * 0.3);
const eye = Math.round(size * 0.125);
---

<span
  class="brand-mark"
  style={`width:${size}px;height:${size}px;border-radius:${radius}px;--eye:${eye}px`}
  aria-hidden="true"></span
>

<style>
  .brand-mark {
    display: inline-block; flex: none;
    background:
      radial-gradient(circle at 50% 50%, var(--surface) 0 var(--eye), transparent calc(var(--eye) + 0.5px)),
      conic-gradient(from 210deg, var(--accent-fill), var(--accent-fill-hover), var(--accent-fill));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-contrast) 18%, transparent), var(--shadow-1);
  }
</style>
