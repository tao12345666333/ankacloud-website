---
import ProductShot from "./ProductShot.astro";
import { DOCS } from "../data/site";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).hero;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="shell">
    <div class="hero-copy">
      <a class="pill" href="https://github.com/tao12345666333/ankacloud" target="_blank" rel="noopener">
        <span class="dot"></span>
        <span>{d.pill}</span>
        <span class="arrow">→</span>
      </a>
      <h1>
        <span class="line">{d.title1}</span>{" "}
        <span class="line">{d.title2Before}<span class="accent">{d.title2Accent}</span>{d.title2After}</span>
      </h1>
      <p class="lede">{d.lede}</p>
      <div class="cta">
        <a class="btn btn-primary" href={DOCS.quickstart} target="_blank" rel="noopener">
          {d.start}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn" href="#architecture">{d.how}</a>
      </div>
      <ul class="facts">
        <li><b>1</b>{d.facts[0]}</li>
        <li><b>1</b>{d.facts[1]}</li>
        <li>{d.facts[2]}</li>
        <li>{d.facts[3]}</li>
      </ul>
    </div>

    <div class="hero-shot">
      <ProductShot
        name="thread-sse-fix"
        width={1280}
        height={860}
        crop="full"
        alt={d.alt}
        caption={d.caption}
      />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: 72px 0 0; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 75%);
  }
  .hero-copy { position: relative; max-width: 820px; margin: 0 auto; text-align: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px;
    border-radius: 999px; border: 1px solid var(--border-strong); background: var(--surface);
    font-size: 12.5px; font-weight: 500; color: var(--text-2); box-shadow: var(--shadow-1);
    transition: border-color .14s ease, color .14s ease;
  }
  .pill:hover { text-decoration: none; color: var(--text); border-color: var(--text-3); }
  .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .pill .arrow { color: var(--text-3); transition: transform .14s ease; }
  .pill:hover .arrow { transform: translateX(2px); }
  h1 {
    margin-top: 26px;
    font-size: clamp(30px, 3.9vw, 52px); font-weight: 680; line-height: 1.12; letter-spacing: -0.03em;
  }
  h1 .line { display: block; }
  .accent { color: var(--accent-text); }
  .lede {
    margin: 24px auto 0; max-width: 660px; font-size: 18px; line-height: 1.7; color: var(--text-2);
  }
  .cta { display: flex; justify-content: center; gap: 12px; margin-top: 34px; flex-wrap: wrap; }
  .cta .btn { height: 44px; padding: 0 20px; font-size: 15px; }
  .facts {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 22px;
    margin: 34px 0 0; padding: 0; list-style: none;
    font-size: 13px; color: var(--text-3);
  }
  .facts li { display: inline-flex; align-items: baseline; gap: 5px; }
  .facts li + li::before {
    content: ""; width: 3px; height: 3px; border-radius: 50%; background: var(--border-strong);
    align-self: center; margin-right: 16px;
  }
  .facts b { color: var(--text); font-weight: 620; font-variant-numeric: tabular-nums; }
  .hero-shot { position: relative; margin: 56px auto 0; max-width: 1060px; }

  @media (max-width: 900px) {
    .hero { padding-top: 48px; }
    h1 .line { display: inline; }
    h1 { text-wrap: balance; }
    .lede { font-size: 16.5px; }
    .hero-shot { margin-top: 40px; }
  }
  @media (max-width: 560px) {
    .facts { gap: 6px 12px; font-size: 12.5px; }
    .facts li + li::before { margin-right: 6px; }
    .facts li:nth-child(3)::before { display: none; }
  }
</style>
