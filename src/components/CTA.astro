---
import BrandMark from "./BrandMark.astro";
import { DOCS, REPO_URL, VERSION } from "../data/site";
import { split, t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).cta;
const [bodyBefore, bodyAfter] = split(d.body, "{version}");
---

<section class="cta-section">
  <div class="shell">
    <div class="cta-card">
      <BrandMark size={64} />
      <h2 set:html={d.title} />
      <p>{bodyBefore}<b class="ver">v{VERSION}</b>{bodyAfter}</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href={REPO_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
          {d.github}
        </a>
        <a class="btn" href={DOCS.quickstart} target="_blank" rel="noopener">{d.quickstart}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { padding: 0 0 var(--section-y); }
  .cta-card {
    position: relative; overflow: hidden; text-align: center;
    padding: 72px 24px 56px; border-radius: 24px;
    background:
      radial-gradient(circle at 50% 50%, var(--accent-soft), transparent 70%),
      var(--surface);
    border: 1px solid var(--border-strong); box-shadow: var(--shadow-2);
  }
  .cta-card :global(.brand-mark) { filter: drop-shadow(0 6px 14px rgb(154 53 23 / .22)); }
  .ver { color: var(--text); font-weight: 600; }
  h2 { margin-top: 22px; font-size: clamp(30px, 4.4vw, 46px); letter-spacing: -0.03em; }
  p { margin: 16px auto 0; max-width: 520px; color: var(--text-2); font-size: 16px; line-height: 1.7; }
  .cta-actions { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-top: 30px; }
  @media (max-width: 600px) {
    .cta-card { padding: 52px 20px 44px; }
  }
</style>
